# 复制这个文件为 .env，填上真实的 key。
# .env 已经在 .gitignore 里，不会被提交 —— 但每次 git add 前还是扫一眼。
#
#   cp .env.example .env

# 主力模型
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 对比组（D14 之后做消融实验时才需要，现在可以留空）
DASHSCOPE_API_KEY=

# 后端
PORT=8000
CACHE_DIR=./cache

# 限流（公网必设；本地开发可以不管）
RATE_IP_PER_HOUR=20
RATE_GLOBAL_PER_DAY=300

# CORS。本地留空=全开；上线后填 chrome-extension://<扩展id>，多个逗号分隔
ALLOWED_ORIGINS=
