{
  "manifest_version": 3,
  "name": "arXiv Reader",
  "version": "0.3.1",
  "description": "Turns arXiv papers into a structured reading guide. Every claim is traced to a paragraph and verified against the source.",
  "permissions": [
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "https://arxiv.org/*",
    "https://arxiv-reader-production.up.railway.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开 arXiv Reader",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://arxiv.org/abs/*",
        "https://arxiv.org/html/*",
        "https://arxiv.org/pdf/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
